{
  "name": "@rdnr/num2es",
  "version": "0.1.0",
  "description": "Convierte números a palabras en español. Soporta monedas, géneros y escalas hasta trillones.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardodrn/num2es"
  },
  "homepage": "https://github.com/ricardodrn/num2es#readme",
  "bugs": {
    "url": "https://github.com/ricardodrn/num2es/issues"
  },
  "keywords": [
    "numero",
    "letras",
    "español",
    "spanish",
    "words",
    "currency",
    "moneda"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --no-coverage",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "release": "changeset publish"
  },
  "lint-staged": {
    "**/*.ts": "eslint --fix"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.12.0",
    "eslint": "^9.14.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.14.0"
  }
}
